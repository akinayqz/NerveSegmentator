+def test_deepseg_nerves_single_input(tmp_path, capsys):
+    """
+    `nerves_lumbar_t2` takes one image at a time (checked before installing or running anything).
+    """
+    pytest.importorskip("nervesegmentator")  # optional package: without it, `sct_deepseg` stops before this check
+    fnames = [str(tmp_path / fname) for fname in ("t2_a.nii.gz", "t2_b.nii.gz")]
+    for fname in fnames:
+        Path(fname).touch()
+    with pytest.raises(SystemExit):
+        sct_deepseg.main(['nerves_lumbar_t2', '-i', *fnames])
+    assert "Please provide a single input file" in capsys.readouterr().err
+
+
+def test_segment_nervesegmentator_outputs(tmp_path):
+    """
+    Check what `sct_deepseg` gets back from NerveSegmentator, using a stand-in for the package's predictor
+    (the real one needs its models): one output per structure, and an error if the image can't be segmented.
+    """
+    class FakeNerveSegmentator:
+        def __init__(self, errors=()):
+            self.errors = list(errors)
+
+        def run(self, image, output_dir, spine_seg=None):
+            self.spine_seg = spine_seg
+            outputs = {} if self.errors else {s: Path(output_dir) / f"t2_{s}.nii.gz" for s in ("drg", "root")}
+            return [SimpleNamespace(status="failed" if self.errors else "ok", errors=self.errors, outputs=outputs)]
+
+    segment = sct.deepseg.inference.segment_nervesegmentator
+    predictor = FakeNerveSegmentator()
+    fnames_out, targets = segment("t2.nii.gz", str(tmp_path), predictor, device="cpu",
+                                  spine_seg="t2_totalspineseg_all.nii.gz")
+    assert predictor.spine_seg == "t2_totalspineseg_all.nii.gz"
+    assert targets == ["_drg", "_root"]
+    assert fnames_out == [str(tmp_path / "t2_drg.nii.gz"), str(tmp_path / "t2_root.nii.gz")]
+
+    predictor = FakeNerveSegmentator(errors=["The L5-S1 disc was not found."])
+    with pytest.raises(ValueError) as e:
+        segment("t2.nii.gz", str(tmp_path), predictor, device="cpu", spine_seg="t2_totalspineseg_all.nii.gz")
+    assert "The L5-S1 disc was not found." in str(e.value)
