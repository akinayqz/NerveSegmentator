+def create_nervesegmentator(path_model, device: torch.device, single_fold: bool = False, test_time_aug: bool = False):
+    """
+    Load the networks of NerveSegmentator (one per structure: dorsal root ganglia, nerve roots).
+
+    For quicker inference using only a single fold per network (instead of the full ensemble), set `single_fold=True`.
+    """
+    [contrast] = ds_models.MODELS[os.path.basename(path_model)]['contrasts']
+    return nervesegmentator.NerveSegmentator(
+        contrast=contrast,
+        device=device,
+        fast=single_fold,
+        tta=test_time_aug,  # mirroring on the axes the networks were trained with (left-right)
+        # nervesegmentator's models are installed in SCT's model folder (see `models.install_model`)
+        data_dir=path_model,
+    )
+
+
+def segment_nervesegmentator(path_img, tmpdir, predictor, device, spine_seg=None):
+    """
+    Segment lumbosacral dorsal root ganglia and nerve roots using NerveSegmentator.
+
+    The networks need to know where each voxel is relative to the spine, which the package works out from a
+    TotalSpineSeg segmentation of the image.
+
+    :param predictor: `nervesegmentator.NerveSegmentator` object, as returned by `create_nervesegmentator`.
+    :param spine_seg: Filename of the spine segmentation of the image: the `_totalspineseg_all` output of
+        `sct_deepseg spine`. If not provided, the spine is segmented first.
+    """
+    if spine_seg is None:
+        name_model_spine = ds_models.TASKS['spine']['models'][0]
+        path_model_spine = ds_models.folder(name_model_spine)
+        if not ds_models.is_valid(ds_models.find_model_folder_paths(path_model_spine)):
+            logger.info(f"Model {name_model_spine} is not installed. Installing it now...")
+            ds_models.install_model(name_model_spine)
+        logger.info("No spine segmentation was provided (`-spine-seg`), so segmenting the spine first...")
+        tmpdir_spine = os.path.join(tmpdir, 'totalspineseg')
+        os.mkdir(tmpdir_spine)
+        fnames_spine, targets_spine = segment_totalspineseg(path_img, tmpdir_spine, path_model_spine, device)
+        spine_seg = fnames_spine[targets_spine.index("_totalspineseg_all")]
+
+    # nervesegmentator handles the orientation of the image and the label values itself, and reports
+    # (through `logging`) anything unusual about the discs that the spinal levels are anchored to
+    [result] = predictor.run(path_img, tmpdir, spine_seg=spine_seg)
+    if result.status == "failed":
+        # e.g. the spinal levels can't be anchored because the spine segmentation has no L5-S1 disc
+        raise ValueError(f"NerveSegmentator could not segment '{path_img}': {' '.join(result.errors)}")
+
+    fnames_out, targets = [], []
+    for structure, fname_out in result.outputs.items():  # 'drg', 'root'
+        fnames_out.append(str(fname_out))
+        targets.append(f"_{structure}")
+
+    return fnames_out, targets
